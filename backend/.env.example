# Copy to backend/.env to run the API directly (outside Docker):
#   uv run alembic upgrade head
#   uv run uvicorn backend.main:app --reload
# When using `docker compose`, configure the root .env instead.

DATABASE_URL=postgresql+asyncpg://sab:change_me_locally@localhost:5432/sab

OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=google/gemini-2.5-flash-image
# Only for models that accept it, e.g. OpenAI gpt-image: low | medium | high | auto.
OPENROUTER_IMAGE_QUALITY=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_DIR=uploads
