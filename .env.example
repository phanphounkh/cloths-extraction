# Copy to .env (next to compose.yaml) and fill in the values.

POSTGRES_USER=sab
# Letters and digits only: the password is embedded in a database URL.
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=sab

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=google/gemini-2.5-flash-image
# Only for models that accept it, e.g. OpenAI gpt-image: low | medium | high | auto.
OPENROUTER_IMAGE_QUALITY=

# Which backend generates images: openrouter | kaggle (GPU notebook, see kaggle/README.md).
IMAGE_BACKEND=openrouter
KAGGLE_BASE_URL=
KAGGLE_API_TOKEN=

# Ports on your machine. Change them if something else already uses them.
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
