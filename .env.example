# Copy to .env (next to compose.yaml) and fill in the values.

POSTGRES_USER=sab
# Letters and digits only: the password is embedded in a database URL.
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=sab

# Hugging Face access token (kept on the backend only).
HF_TOKEN=replace_me
HF_SPACE_URL=https://ivannm-qwen-image-edit-2509-loras-fast2-copy.hf.space
HF_API_NAME=infer
# Includes time waiting in the Space's GPU queue.
HF_TIMEOUT_SECONDS=300

# Ports on your machine. Change them if something else already uses them.
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173
